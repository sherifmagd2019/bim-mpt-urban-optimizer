<Window x:Class="RevitMPTOptimizer.UI.EfficientFrontierWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Generative BIM — Portfolio Efficient Frontier"
        Height="720" Width="1100"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="0,0,0,8">
            <TextBlock Text="Correlation regime:" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <ComboBox x:Name="RegimeCombo" Width="160" SelectionChanged="RegimeCombo_SelectionChanged">
                <ComboBoxItem Content="Low Correlation" IsSelected="True"/>
                <ComboBoxItem Content="High Correlation"/>
            </ComboBox>
            <TextBlock Text="Risk-free rate:" VerticalAlignment="Center" Margin="20,0,6,0"/>
            <TextBox x:Name="RiskFreeBox" Width="60" Text="2.0"/>
            <TextBlock Text="%" VerticalAlignment="Center" Margin="2,0,10,0"/>
            <Button x:Name="RecalculateButton" Content="Recalculate" Padding="10,3" Click="RecalculateButton_Click"/>
            <TextBlock x:Name="StatusText" Margin="20,0,0,0" VerticalAlignment="Center" Foreground="Gray"/>
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="3*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" BorderBrush="#CCCCCC" BorderThickness="1" Margin="0,0,6,0">
                <Canvas x:Name="FrontierCanvas" Background="White" ClipToBounds="True"
                        MouseMove="FrontierCanvas_MouseMove"/>
            </Border>

            <DataGrid x:Name="AllocationGrid" Grid.Column="1" Margin="6,0,0,0"
                      AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Layout / Zone" Binding="{Binding Name}" Width="2*"/>
                    <DataGridTextColumn Header="Zone Type" Binding="{Binding Zone}" Width="*"/>
                    <DataGridTextColumn Header="Weight" Binding="{Binding WeightDisplay}" Width="*"/>
                    <DataGridTextColumn Header="Exp. Yield" Binding="{Binding YieldDisplay}" Width="*"/>
                    <DataGridTextColumn Header="Volatility" Binding="{Binding VolatilityDisplay}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>

        <StackPanel Grid.Row="2" Margin="0,10,0,0">
            <TextBlock x:Name="SelectedPointText" FontWeight="Bold"/>
            <TextBlock x:Name="MaxSharpeText" Margin="0,4,0,0"/>
        </StackPanel>
    </Grid>
</Window>
