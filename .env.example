# =========================================================================================================
# BIM MPT URBAN OPTIMIZER - ENVIRONMENT CONFIGURATION
# =========================================================================================================


# =========================================================================================================
# SERVER CONFIGURATION
# =========================================================================================================

# Express server port
EXPRESS_PORT=3000

# Revit C# add-in listening port
REVIT_ADD_IN_PORT=8080

# Node environment (development, production, test)
NODE_ENV=development

# Logging level (error, warn, info, debug)
LOG_LEVEL=info

# =========================================================================================================
# SECURITY & CORS
# =========================================================================================================

# Allowed origins for CORS (comma-separated)
# IMPORTANT: Restrict to your domain(s) - no longer using wildcard (*)
# Example: "http://localhost:3000,https://yourdomain.com"
CORS_ALLOWED_ORIGINS=http://localhost:3000

# API Rate Limiting
# Number of requests allowed per window
API_RATE_LIMIT_REQUESTS=100

# Rate limit window in milliseconds (15 minutes = 900000ms)
API_RATE_LIMIT_WINDOW_MS=900000

# Maximum request body size
MAX_REQUEST_SIZE=10mb

# =========================================================================================================
# GOOGLE GEMINI AI
# =========================================================================================================

# Get your API key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_google_ai_studio_api_key_here

# Gemini model to use
GEMINI_MODEL=gemini-3.7-flash

# =========================================================================================================
# DATABASE (if you add persistence later)
# =========================================================================================================

# Database connection string (optional)
# DATABASE_URL=

# Database type (mongodb, postgresql, sqlite, etc.)
# DATABASE_TYPE=

# =========================================================================================================
# AUTHENTICATION (add these when implementing auth)
# =========================================================================================================

# JWT secret for token signing (generate a strong random string)
# JWT_SECRET=your_very_long_random_secret_key_here_minimum_32_characters

# JWT token expiry
# JWT_EXPIRY=24h

# API Key for machine-to-machine communication (C# ↔ Express)
# API_KEY=your_secure_api_key_here

# =========================================================================================================
# MONITORING & OBSERVABILITY
# =========================================================================================================

# Sentry error tracking (optional)
# SENTRY_DSN=

# NewRelic APM (optional)
# NEWRELIC_LICENSE_KEY=

# =========================================================================================================
# REVIT INTEGRATION
# =========================================================================================================

# Revit add-in server listening address
REVIT_SERVER_HOST=localhost

# Enable HTTPS for Revit communication (currently false, set true in production)
REVIT_HTTPS_ENABLED=false

# Revit API timeout (milliseconds)
REVIT_TIMEOUT_MS=5000

# =========================================================================================================
# FILE UPLOADS (if needed later)
# =========================================================================================================

# Maximum upload file size
# UPLOAD_MAX_SIZE=50mb

# Allowed upload file types (comma-separated)
# UPLOAD_ALLOWED_TYPES=.rvt,.dxf,.ifc

# Upload directory
# UPLOAD_DIR=./uploads

# =========================================================================================================
# DEVELOPMENT ONLY
# =========================================================================================================

# Enable debug logging
DEBUG=false

# Enable hot module reload (HMR)
VITE_HMR_HOST=localhost
VITE_HMR_PORT=5173

# =========================================================================================================
# PRODUCTION DEPLOYMENT
# =========================================================================================================

# When deploying to production, set:
# NODE_ENV=production
# LOG_LEVEL=warn
# DEBUG=false
# CORS_ALLOWED_ORIGINS=https://yourdomain.com
# REVIT_HTTPS_ENABLED=true
# Add JWT_SECRET
# Add API_KEY if using auth

# =========================================================================================================
# EXAMPLES
# =========================================================================================================

# Example CORS configuration for production:
# CORS_ALLOWED_ORIGINS=https://app.yourdomain.com,https://admin.yourdomain.com

# Example for local development with multiple origins:
# CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000

# Example rate limiting for stricter control:
# API_RATE_LIMIT_REQUESTS=50
# API_RATE_LIMIT_WINDOW_MS=300000  (5 minutes)
